{
  "name": "@dsh-external/dsh-cot-form-b",
  "version": "14.25.4",
  "private": true,
  "type": "module",
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    }
  },
  "scripts": {
    "test": "node verify.mjs",
    "verify": "node verify.mjs",
    "watermark": "node tools/doc-watermark.mjs --write",
    "watermark:check": "node tools/doc-watermark.mjs --check",
    "watermark:record": "node tools/doc-watermark.mjs --record",
    "verify:offline": "node tools/verify-offline.mjs",
    "manifest": "node manifest.mjs",
    "manifest:check": "node manifest.mjs --check",
    "bench": "node tools/cfb-cycle.mjs benchmark",
    "bench:lite": "node tools/cfb-cycle.mjs plan-bench --lite",
    "traj:lite": "node tools/cfb-cycle.mjs plan-traj --lite",
    "cycle": "node tools/cfb-cycle.mjs status",
    "next": "node tools/cfb-cycle.mjs next",
    "prescreen": "node tools/cfb-cycle.mjs prescreen",
    "judge": "node tools/cfb-judge.mjs capacity",
    "train:export": "node tools/cfb-cycle.mjs export-train",
    "restore": "node tools/cfb-cycle.mjs restore",
    "snapshot": "node tools/cfb-cycle.mjs snapshot",
    "onboard": "node deploy/onboard.mjs",
    "trace:audit": "node tools/analyze-trace.mjs",
    "trace:efficiency": "node tools/analyze-efficiency.mjs",
    "effect:bounded:plan": "node tools/bounded-ab.mjs --plan",
    "effect:ready": "node tools/effect-ready.mjs",
    "effect:simulate": "node tools/verify-offline.mjs --ready-simulate"
