# 依赖
node_modules/

# 运行痕迹（trace / 日志不进仓库）
*.log

# 覆盖率产物（c8 / nyc；本地量覆盖率用，不属于包内容）
coverage/
.nyc_output/
# 自测临时目录（os.tmpdir 不可写时 core.selftest 的回退位置）
.cot-form-b-selftest-tmp/

# 历史备份（本包有意不收录，见 README「本包不包含什么」）
*.bak
*.bak-*
*.before-*

# 编辑器 / 系统
.DS_Store
Thumbs.db
.idea/
.vscode/

# 本地证据块仓/检查点/演示产物（不含发布文件，不进 Git/manifest）
.cfb-runtime/

# 说明：MANIFEST.sha256 **要**进仓库 —— 它就是完整性清单本身。

# 可选Python训练器的本地字节码/测试缓存（不属于交付源码）
__pycache__/
*.py[cod]
.pytest_cache/
