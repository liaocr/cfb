{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cfb.local/schemas/micro-generator-annotation-1.json",
  "title": "Micro-generator source-fact annotation with AI single-review provenance",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "caseId",
    "family",
    "finalSplit",
    "raw",
    "ctx",
    "referenceDraft",
    "sourceCoverage",
    "annotationStatus",
    "reviewers",
    "facts",
    "referenceReview",
    "sourceHashes"
  ],
  "properties": {
    "schema": {
      "const": "cfb.micro-generator-annotation/1"
    },
    "caseId": {
      "type": "string",
      "minLength": 1
    },
    "family": {
      "type": "string",
      "minLength": 1
    },
    "finalSplit": {
      "enum": [
        "train",
        "dev",
        "blind",
        null
      ]
    },
    "provenanceSplit": {
      "type": "string"
    },
    "sourceId": {
      "type": "string"
    },
    "source": {
      "type": "string"
    },
    "sourceKind": {
      "enum": [
        "canonical-hand-reference",
        "accepted-capture-review-queue",
        "ai-reviewed-curated"
      ]
    },
    "sourceAudit": {
      "type": "string"
    },
    "referenceStatus": {
      "type": "string"
    },
    "trainingEligible": {
      "type": "boolean"
    },
    "reviewOnlyReason": {
      "type": "string"
    },
    "draftingProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "scope",
        "aiSingleReviewerReviewRequired"
      ],
      "properties": {
        "method": {
          "const": "assistant-context-preamble-proposal/1"
        },
        "scope": {
          "const": "ctx-preamble-snippets-only"
        },
        "aiSingleReviewerReviewRequired": {
          "const": true
        }
      }
    },
    "raw": {
      "type": "string",
      "minLength": 1
    },
    "ctx": {
      "type": "string"
    },
    "referenceDraft": {
      "type": "string",
      "minLength": 1
    },
    "sourceCoverage": {
      "enum": [
        "unreviewed",
        "partial",
        "complete"
      ]
    },
    "annotationStatus": {
      "enum": [
        "unreviewed",
        "draft",
        "reviewed",
        "adjudicated"
      ]
    },
    "reviewers": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "const": "arena-agent-mode"
      },
      "uniqueItems": true,
      "maxItems": 1
    },
    "facts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "factId",
          "proposition",
          "sourceSpan",
          "importance",
          "polarity",
          "modality",
          "conditions",
          "entities",
          "mustPreserve"
        ],
        "properties": {
          "factId": {
            "type": "string",
            "minLength": 1
          },
          "proposition": {
            "type": "string",
            "minLength": 1
          },
          "sourceSpan": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "field",
              "start",
              "end",
              "quote"
            ],
            "properties": {
              "field": {
                "enum": [
                  "raw",
                  "ctx"
                ]
              },
              "start": {
                "type": "integer",
                "minimum": 0
              },
              "end": {
                "type": "integer",
                "minimum": 1
              },
              "quote": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "importance": {
            "enum": [
              "critical",
              "high",
              "medium",
              "low"
            ]
          },
          "polarity": {
            "enum": [
              "positive",
              "negative",
              "mixed",
              "not-applicable",
              "uncertain"
            ]
          },
          "modality": {
            "enum": [
              "asserted",
              "required",
              "prohibited",
              "possible",
              "conditional",
              "reported",
              "uncertain"
            ]
          },
          "conditions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "entities": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "mustPreserve": {
            "type": "boolean"
          },
          "tags": {
            "type": "array",
            "items": {
              "enum": [
                "number",
                "threshold",
                "time",
                "actor",
                "negation",
                "condition",
                "exception",
                "decision",
                "causality",
                "identifier"
              ]
            },
            "uniqueItems": true
          }
        }
      }
    },
    "referenceReview": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "factStatuses",
        "allMustPreserveFactsSatisfied",
        "unsupportedClaimsReviewed",
        "unsupportedClaimsCount"
      ],
      "properties": {
        "status": {
          "enum": [
            "pending",
            "adjudicated"
          ]
        },
        "factStatuses": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "factId",
              "status"
            ],
            "properties": {
              "factId": {
                "type": "string"
              },
              "status": {
                "enum": [
                  "preserved",
                  "omitted",
                  "contradicted",
                  "uncertain"
                ]
              }
            }
          }
        },
        "allMustPreserveFactsSatisfied": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "unsupportedClaimsReviewed": {
          "type": "boolean"
        },
        "unsupportedClaimsCount": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "sourceHashes": {
      "type": "object",
      "required": [
        "rawSha256",
        "ctxSha256",
        "referenceSha256"
      ],
      "additionalProperties": false,
      "properties": {
        "rawSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "ctxSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "referenceSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "reviewProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "reviewerType",
        "reviewerId",
        "reviewerCount",
        "humanReviewerCount",
        "independentSecondReview",
        "reviewedAt",
        "scope",
        "limitations"
      ],
      "properties": {
        "mode": {
          "const": "ai-single-reviewer"
        },
        "reviewerType": {
          "const": "ai"
        },
        "reviewerId": {
          "const": "arena-agent-mode"
        },
        "reviewerCount": {
          "const": 1
        },
        "humanReviewerCount": {
          "const": 0
        },
        "independentSecondReview": {
          "const": false
        },
        "reviewedAt": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "scope": {
          "const": "raw-context-facts-and-reference-claims"
        },
        "limitations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "annotationStatus": {
            "const": "adjudicated"
          }
        },
        "required": [
          "annotationStatus"
        ]
      },
      "then": {
        "required": [
          "reviewProvenance"
        ],
        "properties": {
          "reviewers": {
            "minItems": 1,
            "maxItems": 1
          },
          "sourceCoverage": {
            "const": "complete"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "referenceReview": {
            "properties": {
              "status": {
                "const": "adjudicated"
              }
            },
            "required": [
              "status"
            ]
          }
        },
        "required": [
          "referenceReview"
        ]
      },
      "then": {
        "required": [
          "reviewProvenance"
        ],
        "properties": {
          "reviewers": {
            "minItems": 1,
            "maxItems": 1
          }
        }
      }
    }
  ]
}
