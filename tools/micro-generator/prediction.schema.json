{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cfb.local/schemas/micro-generator-prediction-1.json",
  "title": "Micro-generator prediction and AI single-reviewer adjudication",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "caseId",
    "family",
    "split",
    "inputSha256",
    "model",
    "promptVersion",
    "promptSha256",
    "decoding",
    "latencyMs",
    "draft",
    "review"
  ],
  "properties": {
    "schema": {
      "const": "cfb.micro-generator-prediction/1"
    },
    "caseId": {
      "type": "string",
      "minLength": 1
    },
    "family": {
      "type": "string",
      "minLength": 1
    },
    "split": {
      "enum": [
        "train",
        "dev",
        "blind"
      ]
    },
    "inputSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "revision",
        "weightsSha256",
        "quantization"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "weightsSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "quantization": {
          "type": "string",
          "minLength": 1
        },
        "runtime": {
          "type": "string",
          "minLength": 1
        },
        "artifactBytes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "parameterCount": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "adapterTreeSha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "promptVersion": {
      "type": "string",
      "minLength": 1
    },
    "promptSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "decoding": {
      "type": "object"
    },
    "latencyMs": {
      "type": "number",
      "minimum": 0
    },
    "promptTokens": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "completionTokens": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "draft": {
      "type": "string"
    },
    "blindProtocol": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gateId",
        "gateConfigSha256",
        "blindRegistrySha256"
      ],
      "properties": {
        "gateId": {
          "type": "string",
          "minLength": 1
        },
        "gateConfigSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "blindRegistrySha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "factCoverage",
        "facts",
        "claimCoverage",
        "claims",
        "reviewers",
        "reviewProvenance"
      ],
      "properties": {
        "status": {
          "enum": [
            "pending",
            "adjudicated"
          ]
        },
        "factCoverage": {
          "enum": [
            "pending",
            "complete"
          ]
        },
        "facts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "factId",
              "status"
            ],
            "properties": {
              "factId": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "enum": [
                  "preserved",
                  "omitted",
                  "contradicted",
                  "uncertain"
                ]
              },
              "note": {
                "type": "string"
              }
            }
          }
        },
        "claimCoverage": {
          "enum": [
            "pending",
            "complete"
          ]
        },
        "claims": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "claimId",
              "text",
              "status",
              "sourceFactIds"
            ],
            "properties": {
              "claimId": {
                "type": "string",
                "minLength": 1
              },
              "text": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "enum": [
                  "supported",
                  "unsupported",
                  "contradictory",
                  "uncertain"
                ]
              },
              "sourceFactIds": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "note": {
                "type": "string"
              }
            }
          }
        },
        "reviewers": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "const": "arena-agent-mode"
          },
          "maxItems": 1
        },
        "reviewProvenance": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "mode",
                "reviewerType",
                "reviewerId",
                "reviewerCount",
                "humanReviewerCount",
                "independentSecondReview",
                "reviewedAt",
                "scope",
                "limitations"
              ],
              "properties": {
                "mode": {
                  "const": "ai-single-reviewer"
                },
                "reviewerType": {
                  "const": "ai"
                },
                "reviewerId": {
                  "const": "arena-agent-mode"
                },
                "reviewerCount": {
                  "const": 1
                },
                "humanReviewerCount": {
                  "const": 0
                },
                "independentSecondReview": {
                  "const": false
                },
                "reviewedAt": {
                  "type": "string",
                  "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
                },
                "scope": {
                  "const": "prediction-facts-and-claims"
                },
                "limitations": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          ]
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "split": {
            "const": "blind"
          }
        },
        "required": [
          "split"
        ]
      },
      "then": {
        "required": [
          "blindProtocol"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "review": {
            "properties": {
              "status": {
                "const": "adjudicated"
              }
            },
            "required": [
              "status"
            ]
          }
        },
        "required": [
          "review"
        ]
      },
      "then": {
        "properties": {
          "review": {
            "properties": {
              "factCoverage": {
                "const": "complete"
              },
              "claimCoverage": {
                "const": "complete"
              },
              "reviewers": {
                "minItems": 1,
                "maxItems": 1
              },
              "reviewProvenance": {
                "type": "object",
                "required": [
                  "mode",
                  "reviewerType",
                  "reviewerId",
                  "reviewerCount",
                  "humanReviewerCount",
                  "independentSecondReview",
                  "reviewedAt",
                  "scope",
                  "limitations"
                ]
              }
            }
          }
        }
      }
    }
  ]
}
